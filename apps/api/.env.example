# Server
PORT=4000
NODE_ENV=production

# Database (PostgreSQL connection string, used by Prisma)
DATABASE_URL="postgresql://app_user:CHANGE_ME@localhost:5432/ai_english_teacher?schema=public"

# JWT
# Use a long, random, high-entropy secret in production (e.g. `openssl rand -hex 64`).
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Comma-separated list of allowed CORS origins (no wildcards in production)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Seed data
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe_123"
