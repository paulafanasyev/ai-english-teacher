# Used by docker-compose.yml at the repo root.
# Copy to `.env` and fill in real values before running `docker compose up`.

# --- Postgres ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ai_english_teacher
POSTGRES_PORT=5432

# --- API ---
PORT=4000
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:3000

# --- Seed data (used by `npm run seed` inside the api container) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe_123

# --- Optional tools ---
ADMINER_PORT=8080
